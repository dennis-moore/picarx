{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch --list *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh repo view *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(uptime)",
      "Bash(uname *)",
      "Bash(which *)",
      "Bash(jq *)",

      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(systemctl is-enabled *)",
      "Bash(systemctl list-units *)",
      "Bash(systemctl cat *)",
      "Bash(journalctl *)",
      "Bash(vcgencmd get_throttled)",
      "Bash(vcgencmd measure_temp)",
      "Bash(vcgencmd measure_volts *)",
      "Bash(gpiodetect)",
      "Bash(gpioinfo *)",

      "Bash(cmake -S *)",
      "Bash(cmake -B *)",
      "Bash(cmake --build *)",
      "Bash(cmake --preset *)",
      "Bash(ctest *)",

      "WebFetch(domain:docs.sunfounder.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(picar)",
      "Bash(picar *)",
      "Bash(*/picar)",
      "Bash(*/picar *)",
      "Bash(picard)",
      "Bash(picard *)",
      "Bash(*/picard)",
      "Bash(*/picard *)",

      "Bash(systemctl start *)",
      "Bash(systemctl restart *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl reload *)",
      "Bash(systemctl kill *)",
      "Bash(systemctl enable *)",
      "Bash(systemctl disable *)",
      "Bash(sudo *)",

      "Bash(i2cset *)",
      "Bash(i2cget *)",
      "Bash(i2cdetect *)",
      "Bash(i2ctransfer *)",
      "Bash(i2cdump *)",
      "Bash(gpioset *)",
      "Bash(gpioget *)",
      "Bash(gpiomon *)",
      "Bash(pinctrl *)",
      "Bash(raspi-gpio *)",

      "Bash(python *)",
      "Bash(python3 *)",

      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(poweroff *)",

      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push * master)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * *:master)",
      "Bash(git push * *:main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ]
  }
}
